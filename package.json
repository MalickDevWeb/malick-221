{
  "name": "malick-buss",
  "version": "1.0.0",
  "description": "Marketplace multi-boutiques Malick Buss - Sénégal",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "back-office"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=back-office",
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=back-office",
    "lint": "npm run lint --workspaces",
    "test:coverage": "npm run test:coverage --workspace=backend",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "sonar:logs": "docker compose -f docker-compose.sonar.yml logs -f sonarqube",
    "doc:doctor": "node_modules/pmt_domentation/scripts/doctor.sh",
    "doc:build": "cd docs && latexmk -pdf -synctex=1 -interaction=nonstopmode -halt-on-error -outdir=build main.tex && cp build/main.pdf main.pdf 2>/dev/null || true",
    "doc:clean": "cd docs && rm -rf build main.pdf"
  },
  "keywords": [
    "marketplace",
    "senegal",
    "ecommerce",
    "wave",
    "orange-money",
    "multi-vendor"
  ],
  "author": "Malick Buss",
  "license": "UNLICENSED",
  "devDependencies": {
    "pmt_domentation": "^1.0.1"
  }
}
