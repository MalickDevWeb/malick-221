NODE_ENV=production
PORT=4000
FRONTEND_CLIENT_URL=https://your-frontend-domain.vercel.app
CORS_ORIGINS=https://your-frontend-domain.vercel.app,https://your-back-office-domain.vercel.app
DATABASE_URL="postgresql://user:password@host.neon.tech:5432/neondb?sslmode=require"
REDIS_URL="rediss://default:password@host.upstash.io:6380"
JWT_SECRET="replace_with_a_secure_random_string"
JWT_ACCESS_SECRET="replace_with_a_secure_random_string"
JWT_REFRESH_SECRET="replace_with_a_secure_random_string"
SUPER_ADMIN_PASSWORD="replace_with_a_strong_password"
DEFAULT_COMMISSION_PERCENTAGE=10
DEFAULT_SHIPPING_FEE_PER_SHOP=3000
STOCK_RESERVATION_MINUTES=15
