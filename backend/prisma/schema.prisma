datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  VENDOR
  COURIER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum ShopStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  TO_ACCEPT
  ACCEPTED
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
  REJECTED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CommissionStatus {
  ESTIMATED
  PROVISIONAL
  EARNED
  PAID_OUT
  ADJUSTED
  DISPUTED_HOLD
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum StockMovementType {
  RESERVED
  RELEASED
  FULFILLED
  ADJUSTED
}

enum ProductCondition {
  NEUF
  TRES_BON_ETAT
  BON_ETAT
}

enum AdminCaseType {
  DISPUTE
  REFUND
}

enum AdminCaseStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

model User {
  id           String      @id @default(uuid())
  phoneNumber  String      @unique
  fullName     String
  email        String?     @unique
  passwordHash String
  role         UserRole    @default(CLIENT)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  shops        Shop[]
  orders       Order[]
  orderStatusHistory OrderStatusHistory[]
  stockMovements StockMovement[]
  withdrawalRequests WithdrawalRequest[]
  withdrawalAuditLogs WithdrawalAuditLog[]
  adminAuditLogs AdminAuditLog[]
  updatedPlatformSettings PlatformSetting[]
  adminCases AdminCase[]

  @@map("users")
}

model Shop {
  id                  String      @id @default(uuid())
  ownerId             String
  name                String
  slug                String      @unique
  description         String?
  logoUrl             String?
  bannerUrl           String?
  status              ShopStatus  @default(PENDING_VERIFICATION)
  wavePayoutNumber    String?
  omPayoutNumber      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner               User        @relation(fields: [ownerId], references: [id])
  products            Product[]
  subOrders           SubOrder[]
  withdrawalRequests  WithdrawalRequest[]

  @@map("shops")
}

model Product {
  id            String           @id @default(uuid())
  shopId        String
  title         String
  slug          String
  description   String?
  category      String           @default("Autre")
  imageUrl      String?
  additionalImageUrls String[]   @default([])
  basePrice     Decimal          @db.Decimal(12, 2)
  discountPrice Decimal?         @db.Decimal(12, 2)
  condition     ProductCondition @default(NEUF)
  isPublished   Boolean          @default(true)
  stockQuantity Int              @default(0)
  reservedQuantity Int           @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  shop          Shop             @relation(fields: [shopId], references: [id])
  orderItems    OrderItem[]
  stockMovements StockMovement[]

  @@index([shopId, isPublished, createdAt])
  @@map("products")
}

model Order {
  id               String        @id @default(uuid())
  clientId         String
  idempotencyKey   String?
  requestFingerprint String?
  orderNumber      String        @unique
  grandTotal       Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentReference String?
  shippingAddressSnapshot Json
  stockReservationExpiresAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client           User          @relation(fields: [clientId], references: [id])
  subOrders        SubOrder[]
  stockMovements   StockMovement[]
  adminCases       AdminCase[]

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([status, stockReservationExpiresAt])
  @@map("orders")
}

model SubOrder {
  id                     String           @id @default(uuid())
  orderId                String
  shopId                 String
  subOrderNumber         String           @unique
  subtotalItems          Decimal          @db.Decimal(12, 2)
  shippingFee            Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal          @db.Decimal(12, 2)
  commissionRateApplied  Decimal          @db.Decimal(5, 2)
  commissionAmount       Decimal          @db.Decimal(12, 2)
  vendorNetEarning       Decimal          @db.Decimal(12, 2)
  status                 OrderStatus      @default(PENDING_PAYMENT)
  rejectionReason        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  order                  Order            @relation(fields: [orderId], references: [id])
  shop                   Shop             @relation(fields: [shopId], references: [id])
  items                  OrderItem[]
  commissions            CommissionLedger[]
  statusHistory          OrderStatusHistory[]

  @@index([shopId, status, createdAt])
  @@map("sub_orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  subOrderId           String
  productId            String
  productTitleSnapshot String
  unitPriceSnapshot    Decimal  @db.Decimal(12, 2)
  quantity             Int
  totalLinePrice       Decimal  @db.Decimal(12, 2)

  subOrder             SubOrder @relation(fields: [subOrderId], references: [id])
  product              Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CommissionLedger {
  id               String           @id @default(uuid())
  subOrderId       String
  baseAmount       Decimal          @db.Decimal(12, 2)
  rate             Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(ESTIMATED)
  effectiveDate    DateTime         @default(now())
  createdAt        DateTime         @default(now())

  subOrder         SubOrder         @relation(fields: [subOrderId], references: [id])

  @@index([status, createdAt])
  @@map("commission_ledger")
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  subOrderId String
  actorId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  reason     String?
  createdAt  DateTime    @default(now())

  subOrder   SubOrder    @relation(fields: [subOrderId], references: [id])
  actor      User        @relation(fields: [actorId], references: [id])

  @@index([subOrderId, createdAt])
  @@map("order_status_history")
}

model StockMovement {
  id                    String            @id @default(uuid())
  productId             String
  orderId               String?
  actorId               String?
  type                  StockMovementType
  quantity              Int
  stockQuantityBefore   Int
  reservedQuantityBefore Int
  reason                String
  createdAt             DateTime           @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
  @@map("stock_movements")
}

model WithdrawalRequest {
  id                 String          @id @default(uuid())
  shopId             String
  vendorId           String
  amount             Decimal         @db.Decimal(12, 2)
  fee                Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod      String
  status             WithdrawalStatus @default(PENDING)
  providerReference  String?
  providerStatus     String?
  notes              String?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  shop               Shop            @relation(fields: [shopId], references: [id])
  vendor             User            @relation(fields: [vendorId], references: [id])
  auditLogs          WithdrawalAuditLog[]

  @@index([vendorId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@map("withdrawal_requests")
}

model WithdrawalAuditLog {
  id                  String            @id @default(uuid())
  withdrawalRequestId String
  actorId             String?
  action              String
  statusFrom          WithdrawalStatus?
  statusTo            WithdrawalStatus
  reason              String?
  metadata            Json?
  createdAt           DateTime          @default(now())

  withdrawalRequest   WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id])
  actor               User?             @relation(fields: [actorId], references: [id])

  @@index([withdrawalRequestId, createdAt])
  @@index([actorId, createdAt])
  @@map("withdrawal_audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  version       Int       @default(1)
  payload       Json
  occurredAt    DateTime  @default(now())
  availableAt   DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, availableAt, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@index([updatedById, updatedAt])
  @@map("platform_settings")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

model AdminCase {
  id              String          @id @default(uuid())
  orderId         String
  requesterId     String
  type            AdminCaseType
  status          AdminCaseStatus @default(OPEN)
  reason          String
  requestedAmount Decimal?        @db.Decimal(12, 2)
  decisionReason  String?
  decidedAmount   Decimal?        @db.Decimal(12, 2)
  decidedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order     Order @relation(fields: [orderId], references: [id])
  requester User  @relation(fields: [requesterId], references: [id])

  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@map("admin_cases")
}

