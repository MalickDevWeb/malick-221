datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  VENDOR
  COURIER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum ShopStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  TO_ACCEPT
  ACCEPTED
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CommissionStatus {
  ESTIMATED
  PROVISIONAL
  EARNED
  PAID_OUT
  ADJUSTED
  DISPUTED_HOLD
}

enum ProductCondition {
  NEUF
  TRES_BON_ETAT
  BON_ETAT
}

model User {
  id           String      @id @default(uuid())
  phoneNumber  String      @unique
  fullName     String
  email        String?     @unique
  passwordHash String
  role         UserRole    @default(CLIENT)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  shops        Shop[]
  orders       Order[]

  @@map("users")
}

model Shop {
  id                  String      @id @default(uuid())
  ownerId             String
  name                String
  slug                String      @unique
  description         String?
  logoUrl             String?
  bannerUrl           String?
  status              ShopStatus  @default(PENDING_VERIFICATION)
  wavePayoutNumber    String?
  omPayoutNumber      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner               User        @relation(fields: [ownerId], references: [id])
  products            Product[]
  subOrders           SubOrder[]

  @@map("shops")
}

model Product {
  id            String           @id @default(uuid())
  shopId        String
  title         String
  slug          String
  description   String?
  basePrice     Decimal          @db.Decimal(12, 2)
  discountPrice Decimal?         @db.Decimal(12, 2)
  condition     ProductCondition @default(NEUF)
  isPublished   Boolean          @default(true)
  stockQuantity Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  shop          Shop             @relation(fields: [shopId], references: [id])
  orderItems    OrderItem[]

  @@map("products")
}

model Order {
  id               String        @id @default(uuid())
  clientId         String
  orderNumber      String        @unique
  grandTotal       Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client           User          @relation(fields: [clientId], references: [id])
  subOrders        SubOrder[]

  @@map("orders")
}

model SubOrder {
  id                     String           @id @default(uuid())
  orderId                String
  shopId                 String
  subOrderNumber         String           @unique
  subtotalItems          Decimal          @db.Decimal(12, 2)
  shippingFee            Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal          @db.Decimal(12, 2)
  commissionRateApplied  Decimal          @db.Decimal(5, 2)
  commissionAmount       Decimal          @db.Decimal(12, 2)
  vendorNetEarning       Decimal          @db.Decimal(12, 2)
  status                 OrderStatus      @default(PENDING_PAYMENT)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  order                  Order            @relation(fields: [orderId], references: [id])
  shop                   Shop             @relation(fields: [shopId], references: [id])
  items                  OrderItem[]
  commissions            CommissionLedger[]

  @@map("sub_orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  subOrderId           String
  productId            String
  productTitleSnapshot String
  unitPriceSnapshot    Decimal  @db.Decimal(12, 2)
  quantity             Int
  totalLinePrice       Decimal  @db.Decimal(12, 2)

  subOrder             SubOrder @relation(fields: [subOrderId], references: [id])
  product              Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CommissionLedger {
  id               String           @id @default(uuid())
  subOrderId       String
  baseAmount       Decimal          @db.Decimal(12, 2)
  rate             Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(ESTIMATED)
  effectiveDate    DateTime         @default(now())
  createdAt        DateTime         @default(now())

  subOrder         SubOrder         @relation(fields: [subOrderId], references: [id])

  @@map("commission_ledger")
}
