{
  "name": "@malick-buss/backend",
  "version": "1.0.0",
  "description": "Core Backend API pour Malick Buss (NestJS)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test": "node --test --require ts-node/register test/checkout-planner.spec.ts test/vendor-transition.policy.spec.ts test/cloudinary-product-image.spec.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --require ts-node/register test/checkout-planner.spec.ts test/vendor-transition.policy.spec.ts test/cloudinary-product-image.spec.ts",
    "test:unit": "node --test --require ts-node/register test/checkout-planner.spec.ts test/vendor-transition.policy.spec.ts test/cloudinary-product-image.spec.ts",
    "test:api": "node --test --test-concurrency=1 --require ts-node/register test/api-*.spec.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:test": "node --require ts-node/register src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@malick-buss/shared": "*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
